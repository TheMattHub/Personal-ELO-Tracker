# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.

# Long random string used to sign session cookies. Required for logins to survive a restart.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: email sending for invites and notifications (Gmail example shown).
# For Gmail, use an app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_SENDER=

# Optional: where fallback emails are logged if SMTP sending is unavailable or unset.
MAIL_OUTBOX=instance/mail-outbox.log

# Optional: write a JSON backup snapshot to data/snapshots/ on every change. Off by default.
# AUTO_SNAPSHOT_TO_REPO=1

# Optional: also git-commit each snapshot automatically. Requires AUTO_SNAPSHOT_TO_REPO=1 and a
# local git checkout. Off by default — turn on only if you understand it will create commits
# containing your app's data on your behalf.
# AUTO_GIT_COMMIT=1
